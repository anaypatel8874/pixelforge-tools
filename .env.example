# --- AI / provider configuration (optional) ---
# When set, AI-powered tools will use a remote provider.
# If left blank, tools fall back to on-device algorithms and clearly say so in the UI.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# --- Analytics (optional, disabled by default) ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Rate limiting (basic) ---
RATE_LIMIT_PER_MINUTE=60

# --- Privacy ---
# Maximum payload size for any server-side tool, in bytes.
MAX_UPLOAD_BYTES=20971520

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
